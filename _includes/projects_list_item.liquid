<div class="card h-100">
  <div class="card-body d-flex flex-column">
    <div class="d-flex justify-content-between align-items-baseline mb-2">
      <h3 class="card-title mb-0 h5">
        {% if project.url %}
          <a href="{{ project.url }}" target="_blank" rel="noopener noreferrer">{{ project.title }} <i class="fa-solid fa-up-right-from-square fa-xs ml-1"></i></a>
        {% else %}
          {{ project.title }}
        {% endif %}
      </h3>
      {% if project.date %}
        <span class="badge badge-light text-muted border ml-4">{{ project.date }}</span>
      {% endif %}
    </div>
    
    {% if project.company %}
      <h6 class="card-subtitle mb-3 text-muted" style="font-size: 0.9rem;">
        <i class="fa-regular fa-building fa-sm mr-1"></i> {{ project.company }}
      </h6>
    {% endif %}

    <p class="card-text flex-grow-1" style="font-size: 0.95rem;">{{ project.description }}</p>

    {% if project.clients and project.clients.size > 0 %}
      <div class="mb-3 text-muted" style="font-size: 0.85rem;">
        <i class="fa-solid fa-users fa-sm mr-1"></i> <strong>Clientes:</strong> {{ project.clients | join: ", " }}
      </div>
    {% endif %}

    {% if project.tags and project.tags.size > 0 %}
      <div class="project-tags mt-2">
        {% for tag in project.tags %}
          <span class="badge badge-pill badge-secondary" style="font-size: 0.75rem; margin-right: 0.3rem; margin-bottom: 0.3rem;">
            <i class="fa-solid fa-tag fa-xs"></i> {{ tag }}
          </span>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
